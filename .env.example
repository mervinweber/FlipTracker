# Browser-safe Convex deployment URL. Use development locally and production in Vercel Production.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Optional during the migration; required before inviting beta users.
# Create this in Clerk and use pk_test_ locally, pk_live_ in Vercel Production.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# eBay client secrets and seller tokens must not be placed in this Vite file.
# Configure them as Convex environment variables; see SETUP.md.
